FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY ML/research/llm_semantic_reranker/ /app/ML/research/llm_semantic_reranker/
COPY ML/research/current_market_evidence/ /app/ML/research/current_market_evidence/

RUN pip install --no-cache-dir \
    -r /app/ML/research/llm_semantic_reranker/inference_api/requirements.txt

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["sh", "-c", "python -m uvicorn ML.research.llm_semantic_reranker.inference_api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
